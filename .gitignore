.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials/
*.seed
seed-phrase*
mnemonic*

# local scan store (lives outside the tree by default; belt-and-braces)
.data/
data/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# platform
.vercel/
.netlify/
next-env.d.ts

# local QA artifacts
qa/shots/
qa/*.png
# Ad-hoc QA scratch scripts (temporary reporters, demos, probes).

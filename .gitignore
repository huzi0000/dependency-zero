# dependencies & build output
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# env & secrets — never commit any of these
.env
.env.*
!.env.example
# Also catch a copy named by the operator rather than by the toolchain
# (prod.env, secrets.env, dev.env). `.env*` alone would not match those.
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials/
*.seed
seed-phrase*
mnemonic*

# Signing-key directories. These live outside the repo by default, but
# DZ_DATA_DIR can be pointed anywhere — including into the working tree.
# Refuse to track key material even if that happens by mistake.
keys/
**/keys/
scanner-identities.json
attester*.json

# local scan store (lives outside the tree by default; belt-and-braces)
.data/
data/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# platform
.vercel/
.netlify/
next-env.d.ts

# qa/ — browser probes, screenshots, exported proof bundles and scratch
# attestations. None of it is part of the build. The maintained automated suite
# lives in tests/ and is always tracked.
#
# `qa/*` (not `qa/`): excluding the directory itself stops git descending into
# it, and a `!` rule for a child can then never re-include anything. Matching
# the contents leaves the folder itself traversable so the exception works.
qa/*
!qa/.gitkeep

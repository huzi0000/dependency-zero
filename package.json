{
  "name": "dependency-zero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "d0": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/d0.ts",
    "d0-verify": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/d0-verify.ts",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
